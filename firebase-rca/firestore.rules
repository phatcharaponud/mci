rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isAdmin() {
      return request.auth != null && request.auth.token.email == 'phatcharapon.ud@up.ac.th';
    }
    // หน่วยงานของผู้ใช้ที่กำลังเรียก อ่านจากโปรไฟล์ของตัวเอง
    function myDept() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.department;
    }

    // Users collection - ผู้ใช้อ่านข้อมูลตัวเอง, admin อ่านทั้งหมด
    match /users/{userId} {
      allow read: if request.auth != null && (request.auth.uid == userId || request.auth.token.email == 'phatcharapon.ud@up.ac.th');
      allow create: if request.auth != null && request.auth.uid == userId;
      allow update: if request.auth != null && (request.auth.uid == userId || request.auth.token.email == 'phatcharapon.ud@up.ac.th');
    }

    // RCA records
    // อ่านได้เฉพาะ: รายการของหน่วยงานตัวเอง (ownerDept) / รายการที่ตัวเองสร้าง /
    //              รายการที่ได้รับอนุมัติให้ร่วมแก้ไข / ผู้ดูแลระบบเห็นทั้งหมด
    // หมายเหตุ: ฝั่งเว็บต้อง query ด้วยเงื่อนไขที่ตรงกับกติกานี้ (where ownerDept / ownerUid /
    //          collaborators) มิฉะนั้น Firestore จะปฏิเสธทั้ง query
    match /rca/{rcaId} {
      allow read: if request.auth != null && (
        isAdmin() ||
        resource.data.ownerUid == request.auth.uid ||
        request.auth.uid in resource.data.collaborators ||
        resource.data.ownerDept == myDept()
      );
      allow create: if request.auth != null;
      allow update: if request.auth != null && (
        resource.data.ownerUid == request.auth.uid ||
        request.auth.uid in resource.data.collaborators ||
        request.auth.token.email == 'phatcharapon.ud@up.ac.th'
      );
      allow delete: if request.auth != null && (
        resource.data.ownerUid == request.auth.uid ||
        request.auth.token.email == 'phatcharapon.ud@up.ac.th'
      );
    }

    // คำขอร่วมแก้ไข RCA - ใครก็ส่งคำขอได้, เจ้าของรายการ/admin อนุมัติหรือปฏิเสธ
    match /editRequests/{reqId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null && request.resource.data.requesterUid == request.auth.uid;
      allow update, delete: if request.auth != null && (
        resource.data.ownerUid == request.auth.uid ||
        request.auth.token.email == 'phatcharapon.ud@up.ac.th'
      );
    }

    // Schedules - ผู้ใช้ที่อนุมัติแล้วอ่าน/เขียนได้
    match /schedules/{scheduleId} {
      allow read, write: if request.auth != null;
    }

    // Board posts - ผู้ใช้ที่อนุมัติแล้วอ่าน/เขียนได้
    match /posts/{postId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null;
      allow update, delete: if request.auth != null && (
        resource.data.authorUid == request.auth.uid ||
        request.auth.token.email == 'phatcharapon.ud@up.ac.th'
      );

      // Replies
      match /replies/{replyId} {
        allow read: if request.auth != null;
        allow create: if request.auth != null;
        allow update, delete: if request.auth != null && (
          resource.data.authorUid == request.auth.uid ||
          request.auth.token.email == 'phatcharapon.ud@up.ac.th'
        );
      }
    }

    // App settings (เช่น Gemini API key) - ทุกคนที่ login อ่านได้, admin แก้ไขได้
    match /settings/{docId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.token.email == 'phatcharapon.ud@up.ac.th';
    }

    // Access logs
    // ประวัติการเข้าใช้งาน - ทุกคนที่ล็อกอินเขียนของตัวเองได้ แต่อ่าน/ลบได้เฉพาะผู้ดูแลระบบ
    // แก้ไขไม่ได้เลย (ไม่มี allow update) เพื่อให้ประวัติย้อนหลังเชื่อถือได้
    match /logs/{logId} {
      allow create: if request.auth != null && request.resource.data.uid == request.auth.uid;
      allow read, delete: if request.auth != null && request.auth.token.email == 'phatcharapon.ud@up.ac.th';
    }
  }
}
